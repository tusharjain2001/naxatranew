# Copy to .env.local and fill in.
# reCAPTCHA v2 checkbox site key (the secret key belongs in the backend's .env only).
VITE_RECAPTCHA_SITE_KEY=
# Address of the form backend (naxatranew-backend), e.g. https://api.naxatralabs.com.
# Leave empty to call /api on this site (the dev and preview servers proxy it to localhost:5000).
VITE_API_URL=
